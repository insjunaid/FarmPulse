# FarmPulse Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://farmpulse:farmpulse123@localhost:5432/farmpulse

# MSG91 SMS Configuration
# Get your API key from https://msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=FARMPL
MSG91_ROUTE=4
MSG91_COUNTRY=91

# Exotel IVR Configuration
# Get your credentials from https://exotel.com
EXOTEL_API_KEY=
EXOTEL_API_SECRET=
EXOTEL_VIRTUAL_NUMBER=

# AgMarkNet API (Optional - uses mock data if not configured)
AGMARKNET_API_KEY=

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
